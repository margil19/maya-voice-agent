{
  "name": "maya-voice-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "agent:sync": "tsx --env-file=.env.local scripts/sync-agent.mts",
    "agent:smoke": "tsx --env-file=.env.local scripts/smoke-chat.mts",
    "agent:publish": "tsx --env-file=.env.local scripts/publish-agent.mts"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "retell-sdk": "^6.2.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
